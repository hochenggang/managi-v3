# docker-compose 使用的环境变量样板：cp .env.example .env 后按需修改
# .env 与 docker-compose.yml 同目录即可被自动读取；已加入 .gitignore，不会入库。

# 必填：BasicAuth 密码。留空会让容器每次重启生成新的随机口令并打印到启动日志，
# 配合 restart: unless-stopped 等于「每次重启密码都变」，日志里还留历史明文。
MANAGI_BASICAUTH_PASSWORD=change-me

# 选填：BasicAuth 用户名（默认 admin）
MANAGI_BASICAUTH_USERNAME=admin
